BOT_TOKEN=
# Профиль в Telegram (пусто — тексты по умолчанию для «Голос бренда»)
BOT_SHORT_DESCRIPTION=
BOT_DESCRIPTION=
BOT_PROFILE_LANGUAGE=ru
DATABASE_URL=sqlite+aiosqlite:///./reviewpilot.db
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
FERNET_KEY=
# Telegram user id администратора (узнать: @userinfobot)
ADMIN_IDS=1133349945
TRIAL_PRO_DAYS=3
FREE_API_PUBLISHES=3
SUPPORT_USERNAME=brend_voice_support
# Юр. лицо в текстах политики и соглашения (кнопки «Конфиденциальность» / «Полные условия» в боте)
LEGAL_OPERATOR_NAME=
# Опционально: дублирующие ссылки на ваш сайт (ряд «🌐 … (сайт)» на экране принятия)
PRIVACY_POLICY_URL=
TERMS_OF_SERVICE_URL=
# Баннер «Что нового» на сводке — смените значение, чтобы показать снова
PRODUCT_NEWS_VERSION=2026-10-v1
# SLA активации подписки после QR / оплаты по счёту (часы)
PAYMENT_ACTIVATION_SLA_HOURS=24
LOG_LEVEL=INFO
POLL_INTERVAL_MINUTES=15
# Алерт админам (ADMIN_IDS), если poller не был OK дольше N минут
POLLER_STALE_MINUTES=35
DIGEST_HOUR_UTC=6
# Напоминание о «застоявшихся» отзывах в очереди (NEW > N часов), раз в сутки
STALE_REVIEW_HOURS=24
STALE_REMINDER_HOUR_UTC=15
LLM_QUEUE_WORKERS=2
PAYMENT_PROVIDER_TOKEN=
# Telegram Stars (XTR): send_invoice с пустым provider_token — см. https://habr.com/ru/articles/907158/
PAYMENT_ENABLE_STARS=true
CRYPTO_PAY_API_TOKEN=
CRYPTO_PAY_TESTNET=false
CRYPTO_LITE_AMOUNT_USD=10
CRYPTO_PRO_AMOUNT_USD=20
CRYPTO_PAY_WEBHOOK_PATH=/cryptopay/webhook
PAYMENT_CURRENCY=RUB
SUBSCRIPTION_LITE_PRICE_RUB=990
SUBSCRIPTION_PRO_PRICE_RUB=1990
SUBSCRIPTION_LITE_PRICE_BYN=35
SUBSCRIPTION_PRO_PRICE_BYN=70
SUBSCRIPTION_LITE_PRICE_MINOR=99000
SUBSCRIPTION_PRO_PRICE_MINOR=199000
# Stars: по умолчанию Lite/PRO ₽ × (1 + markup%). Явные суммы — опционально.
SUBSCRIPTION_STARS_MARKUP_PERCENT=30
# SUBSCRIPTION_LITE_STARS=
# SUBSCRIPTION_PRO_STARS=
SUBSCRIPTION_LITE_USD=10
SUBSCRIPTION_PRO_USD=20
FX_FALLBACK_USD_RUB=90
FX_FALLBACK_USD_BYN=3.3
QR_PAYMENT_INSTRUCTIONS=Укажите реквизиты ERIP/QR вашего проекта.
LEGAL_PAYMENT_INSTRUCTIONS=Счёт для юр. лиц: реквизиты и email бухгалтерии — уточняйте у поддержки.
# Webhook (prod): если пусто — polling
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
HEALTH_PORT=8081
# Опционально: Redis для FSM (webhook / несколько воркеров). Пусто — память процесса.
FSM_REDIS_URL=
SENTRY_DSN=
